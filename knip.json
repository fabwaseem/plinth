{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {".": {"entry": ["scripts/**/*.ts"], "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}"]}, "packages/yt-dlp-bridge": {"project": ["src/**/*.ts", "tests/**/*.ts"]}, "packages/ytdlp-errors": {"project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs", "*.config.ts"]}},
	"ignore": ["src/renderer/src/components/ui/**"],
	"ignoreExportsUsedInFile": {"interface": true, "type": true},
	"ignoreDependencies": ["@iconify-json/logos", "@iconify-json/simple-icons", "@svgr/plugin-jsx"],
	"ignoreBinaries": ["msgmerge", "ditto", "robocopy", "hdiutil", "terminal-notifier", "shellcheck"],
	"ignoreUnresolved": ["~icons/.*"]
}
